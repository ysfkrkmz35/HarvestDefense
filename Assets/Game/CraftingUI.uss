/* ══════════════════════════════════════════════════════════════════
   CraftingUI.uss - Minecraft-style Crafting UI Stylesheet
   Matches Happy Harvest theme (blue popups, Curse Casual font)
   FIXED: Picking mode and interaction issues
   ══════════════════════════════════════════════════════════════════ */

/* ═══ ROOT VARIABLES ═══ */
:root {
    --main-color: rgb(0, 127, 226);
    --main-color-dark: rgb(0, 90, 180);
    --main-radius: 20px;
    --slot-size: 64px;
    --slot-margin: 4px;
    --slot-bg: rgba(0, 0, 0, 0.4);
    --slot-border: rgba(255, 255, 255, 0.3);
    --slot-hover: rgba(255, 255, 255, 0.5);
    --text-color: rgb(255, 255, 255);
    --success-color: rgb(100, 200, 100);
    --error-color: rgb(200, 100, 100);
}

/* ═══ CRAFTING POPUP CONTAINER ═══ */
#CraftingPopup {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.5);
    /* CRITICAL FIX: Background should block clicks, but children can override */
    picking-mode: position;
}

#CraftingPopup.hidden {
    display: none;
}

/* Background overlay - clicks here should close popup or be blocked */
#CraftingPopup::before {
    picking-mode: position;
}

/* ═══ MAIN PANEL ═══ */
#CraftingPanel {
    /* CRITICAL FIX: Panel MUST capture pointer events */
    picking-mode: position;
    position: absolute;
    background-color: var(--main-color);
    border-radius: var(--main-radius);
    padding: 15px;
    min-width: 400px;
    min-height: 450px;
    flex-direction: column;
    /* Add shadow for depth */
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
}

/* ═══ HEADER ═══ */
#Header {
    /* CRITICAL FIX: Enable pointer events for dragging and clicking */
    picking-mode: position;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
    padding: 8px;
    padding-bottom: 10px;
    border-bottom-width: 2px;
    border-bottom-color: rgba(255, 255, 255, 0.2);
    /* Indicate draggable */
    cursor: move;
    background-color: rgba(0, 0, 0, 0.1);
    border-radius: 8px;
}

#Header:hover {
    background-color: rgba(0, 0, 0, 0.15);
}

#Title {
    /* CRITICAL FIX: Don't block parent clicks */
    picking-mode: ignore;
    font-size: 28px;
    color: var(--text-color);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

#CloseButton {
    /* CRITICAL FIX: Button must capture clicks */
    picking-mode: position;
    width: 36px;
    height: 36px;
    border-radius: 18px;
    background-color: rgba(0, 0, 0, 0.3);
    border-width: 0;
    font-size: 20px;
    color: var(--text-color);
    cursor: pointer;
    transition-duration: 0.1s;
}

#CloseButton:hover {
    background-color: rgba(255, 100, 100, 0.5);
    scale: 1.1;
}

#CloseButton:active {
    scale: 0.95;
}

/* ═══ CRAFTING AREA ═══ */
#CraftingArea {
    picking-mode: position;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 15px;
    margin-bottom: 15px;
}

/* ═══ GRID CONTAINER ═══ */
#GridContainer {
    picking-mode: position;
    flex-direction: column;
    align-items: center;
}

#GridLabel {
    picking-mode: ignore;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 8px;
}

#CraftingGrid {
    picking-mode: position;
    flex-direction: column;
    background-color: rgba(0, 0, 0, 0.3);
    padding: 8px;
    border-radius: 10px;
}

.grid-row {
    picking-mode: position;
    flex-direction: row;
}

/* ═══ CRAFTING SLOTS ═══ */
.craft-slot {
    /* CRITICAL FIX: Must capture click events */
    picking-mode: position;
    width: var(--slot-size);
    height: var(--slot-size);
    margin: var(--slot-margin);
    background-color: var(--slot-bg);
    border-width: 2px;
    border-color: var(--slot-border);
    border-radius: 8px;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition-duration: 0.1s;
}

.craft-slot:hover {
    border-color: var(--slot-hover);
    background-color: rgba(255, 255, 255, 0.15);
    scale: 1.05;
}

.craft-slot:active {
    scale: 0.95;
}

.craft-slot.has-item {
    border-color: rgba(100, 200, 100, 0.6);
    background-color: rgba(100, 200, 100, 0.1);
}

.slot-icon {
    /* CRITICAL FIX: Let parent slot receive clicks */
    picking-mode: ignore;
    width: 48px;
    height: 48px;
    -unity-background-scale-mode: scale-to-fit;
}

.slot-count {
    /* CRITICAL FIX: Let parent slot receive clicks */
    picking-mode: ignore;
    position: absolute;
    right: 2px;
    bottom: 2px;
    font-size: 14px;
    color: var(--text-color);
    -unity-font-style: bold;
    background-color: rgba(0, 0, 0, 0.6);
    padding: 2px 5px;
    border-radius: 4px;
}

/* ═══ ARROW ═══ */
#Arrow {
    picking-mode: ignore;
    font-size: 48px;
    color: var(--text-color);
    margin: 0 20px;
    -unity-text-align: middle-center;
}

/* ═══ OUTPUT AREA ═══ */
#OutputContainer {
    picking-mode: position;
    flex-direction: column;
    align-items: center;
}

#OutputLabel {
    picking-mode: ignore;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 8px;
}

#OutputSlot {
    picking-mode: position;
    width: 80px;
    height: 80px;
    background-color: rgba(0, 0, 0, 0.4);
    border-width: 3px;
    border-color: rgba(100, 200, 100, 0.5);
    border-radius: 10px;
    align-items: center;
    justify-content: center;
}

#OutputSlot.has-result {
    border-color: var(--success-color);
    background-color: rgba(100, 200, 100, 0.2);
}

#OutputIcon {
    picking-mode: ignore;
    width: 56px;
    height: 56px;
    -unity-background-scale-mode: scale-to-fit;
}

#OutputCount {
    picking-mode: ignore;
    position: absolute;
    right: 4px;
    bottom: 4px;
    font-size: 16px;
    color: var(--text-color);
    -unity-font-style: bold;
    background-color: rgba(0, 0, 0, 0.6);
    padding: 2px 6px;
    border-radius: 5px;
}

/* ═══ CRAFT BUTTON ═══ */
#CraftButton {
    /* CRITICAL FIX: Button must capture clicks */
    picking-mode: position;
    margin-top: 15px;
    padding: 10px 30px;
    font-size: 18px;
    color: var(--text-color);
    background-color: var(--success-color);
    border-radius: 10px;
    border-width: 0;
    -unity-font-style: bold;
    cursor: pointer;
    transition-duration: 0.1s;
}

#CraftButton:hover {
    scale: 1.05;
    background-color: rgb(120, 220, 120);
}

#CraftButton:active {
    scale: 0.95;
}

#CraftButton:disabled {
    background-color: rgba(100, 100, 100, 0.5);
    color: rgba(255, 255, 255, 0.5);
    cursor: default;
}

#CraftButton:disabled:hover {
    scale: 1.0;
}

/* ═══ RECIPE INFO ═══ */
#RecipeInfo {
    picking-mode: position;
    flex-direction: column;
    align-items: center;
    padding: 10px;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 10px;
    margin-bottom: 15px;
}

#RecipeName {
    picking-mode: ignore;
    font-size: 18px;
    color: var(--text-color);
    -unity-font-style: bold;
    margin-bottom: 5px;
}

#RecipeDescription {
    picking-mode: ignore;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.7);
    -unity-text-align: middle-center;
}

/* ═══ INVENTORY SECTION ═══ */
#InventorySection {
    picking-mode: position;
    flex-direction: column;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 15px;
    padding: 10px;
}

#InventoryLabel {
    picking-mode: ignore;
    font-size: 16px;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 8px;
    -unity-text-align: middle-center;
}

#InventoryRow {
    picking-mode: position;
    flex-direction: row;
    justify-content: center;
    flex-wrap: wrap;
}

.inventory-slot {
    /* CRITICAL FIX: Must capture click events */
    picking-mode: position;
    width: 56px;
    height: 56px;
    margin: 3px;
    background-color: var(--slot-bg);
    border-width: 2px;
    border-color: var(--slot-border);
    border-radius: 6px;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition-duration: 0.1s;
}

.inventory-slot:hover {
    border-color: var(--slot-hover);
    background-color: rgba(255, 255, 255, 0.15);
    scale: 1.05;
}

.inventory-slot:active {
    scale: 0.95;
}

.inventory-slot.selected {
    border-color: rgb(255, 200, 100);
    border-width: 3px;
    background-color: rgba(255, 200, 100, 0.2);
}

.inv-slot-icon {
    /* CRITICAL FIX: Let parent slot receive clicks */
    picking-mode: ignore;
    width: 40px;
    height: 40px;
    -unity-background-scale-mode: scale-to-fit;
}

.inv-slot-count {
    /* CRITICAL FIX: Let parent slot receive clicks */
    picking-mode: ignore;
    position: absolute;
    right: 1px;
    bottom: 1px;
    font-size: 12px;
    color: var(--text-color);
    -unity-font-style: bold;
    background-color: rgba(0, 0, 0, 0.6);
    padding: 1px 4px;
    border-radius: 3px;
}

/* ═══ MODE INDICATOR ═══ */
#ModeIndicator {
    picking-mode: ignore;
    padding: 5px 12px;
    background-color: rgba(0, 0, 0, 0.4);
    border-radius: 8px;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.7);
    margin-left: auto;
    margin-right: 10px;
}

/* ═══ HINT TEXT ═══ */
#HintText {
    picking-mode: ignore;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.5);
    -unity-text-align: middle-center;
    margin-top: 10px;
}

/* ═══ 2x2 MODE HIDING ═══ */
.extra-slot {
    display: none;
}

.extra-row {
    display: none;
}

.mode-3x3 .extra-slot {
    display: flex;
}

.mode-3x3 .extra-row {
    display: flex;
}
