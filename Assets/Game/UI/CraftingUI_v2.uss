/* ══════════════════════════════════════════════════════════════════
   CraftingUI.uss - Minecraft-style Crafting UI Stylesheet
   Matches Happy Harvest theme (blue popups, Curse Casual font)
   Fixed for Unity UI Builder compatibility
   ══════════════════════════════════════════════════════════════════ */

/* ═══ CRAFTING POPUP CONTAINER ═══ */
#CraftingPopup {
    position: absolute;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.5);
}

#CraftingPopup.hidden {
    display: none;
}

/* ═══ MAIN PANEL ═══ */
#CraftingPanel {
    position: absolute;
    background-color: rgb(0, 127, 226);
    border-radius: 20px;
    padding: 15px;
    min-width: 400px;
    min-height: 450px;
    flex-direction: column;
}

/* ═══ HEADER ═══ */
#Header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
    padding-bottom: 10px;
    border-bottom-width: 2px;
    border-bottom-color: rgba(255, 255, 255, 0.2);
}

#Title {
    font-size: 28px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

#CloseButton {
    width: 36px;
    height: 36px;
    border-radius: 18px;
    background-color: rgba(0, 0, 0, 0.3);
    border-width: 0;
    font-size: 20px;
    color: rgb(255, 255, 255);
}

#CloseButton:hover {
    background-color: rgba(255, 100, 100, 0.5);
}

/* ═══ CRAFTING AREA ═══ */
#CraftingArea {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 15px;
    margin-bottom: 15px;
}

/* ═══ GRID CONTAINER ═══ */
#GridContainer {
    flex-direction: column;
    align-items: center;
}

#GridLabel {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 8px;
}

#CraftingGrid {
    flex-direction: column;
    background-color: rgba(0, 0, 0, 0.3);
    padding: 8px;
    border-radius: 10px;
}

.grid-row {
    flex-direction: row;
}

/* ═══ CRAFTING SLOTS ═══ */
.craft-slot {
    width: 64px;
    height: 64px;
    margin: 4px;
    background-color: rgba(0, 0, 0, 0.4);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.3);
    border-radius: 8px;
    align-items: center;
    justify-content: center;
}

.craft-slot:hover {
    border-color: rgba(255, 255, 255, 0.5);
    background-color: rgba(255, 255, 255, 0.15);
}

.craft-slot.has-item {
    border-color: rgba(100, 200, 100, 0.6);
}

.slot-icon {
    width: 48px;
    height: 48px;
    -unity-background-scale-mode: scale-to-fit;
}

.slot-count {
    position: absolute;
    right: 2px;
    bottom: 2px;
    font-size: 14px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    background-color: rgba(0, 0, 0, 0.6);
    padding: 2px 5px;
    border-radius: 4px;
}

/* ═══ ARROW ═══ */
#Arrow {
    font-size: 48px;
    color: rgb(255, 255, 255);
    margin-left: 20px;
    margin-right: 20px;
    -unity-text-align: middle-center;
}

/* ═══ OUTPUT AREA ═══ */
#OutputContainer {
    flex-direction: column;
    align-items: center;
}

#OutputLabel {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 8px;
}

#OutputSlot {
    width: 80px;
    height: 80px;
    background-color: rgba(0, 0, 0, 0.4);
    border-width: 3px;
    border-color: rgba(100, 200, 100, 0.5);
    border-radius: 10px;
    align-items: center;
    justify-content: center;
}

#OutputSlot.has-result {
    border-color: rgb(100, 200, 100);
    background-color: rgba(100, 200, 100, 0.2);
}

#OutputIcon {
    width: 56px;
    height: 56px;
    -unity-background-scale-mode: scale-to-fit;
}

#OutputCount {
    position: absolute;
    right: 4px;
    bottom: 4px;
    font-size: 16px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    background-color: rgba(0, 0, 0, 0.6);
    padding: 2px 6px;
    border-radius: 5px;
}

/* ═══ CRAFT BUTTON ═══ */
#CraftButton {
    margin-top: 15px;
    padding: 10px 30px;
    font-size: 18px;
    color: rgb(255, 255, 255);
    background-color: rgb(100, 200, 100);
    border-radius: 10px;
    border-width: 0;
    -unity-font-style: bold;
}

#CraftButton:hover {
    background-color: rgb(120, 220, 120);
}

#CraftButton:disabled {
    background-color: rgba(100, 100, 100, 0.5);
    color: rgba(255, 255, 255, 0.5);
}

/* ═══ RECIPE INFO ═══ */
#RecipeInfo {
    flex-direction: column;
    align-items: center;
    padding: 10px;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 10px;
    margin-bottom: 15px;
}

#RecipeName {
    font-size: 18px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    margin-bottom: 5px;
}

#RecipeDescription {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.7);
    -unity-text-align: middle-center;
}

/* ═══ INVENTORY SECTION ═══ */
#InventorySection {
    flex-direction: column;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 15px;
    padding: 10px;
}

#InventoryLabel {
    font-size: 16px;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 8px;
    -unity-text-align: middle-center;
}

#InventoryRow {
    flex-direction: row;
    justify-content: center;
    flex-wrap: wrap;
}

.inventory-slot {
    width: 56px;
    height: 56px;
    margin: 3px;
    background-color: rgba(0, 0, 0, 0.4);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.3);
    border-radius: 6px;
    align-items: center;
    justify-content: center;
}

.inventory-slot:hover {
    border-color: rgba(255, 255, 255, 0.5);
    background-color: rgba(255, 255, 255, 0.15);
}

.inventory-slot.selected {
    border-color: rgb(255, 200, 100);
    border-width: 3px;
}

.inv-slot-icon {
    width: 40px;
    height: 40px;
    -unity-background-scale-mode: scale-to-fit;
}

.inv-slot-count {
    position: absolute;
    right: 1px;
    bottom: 1px;
    font-size: 12px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    background-color: rgba(0, 0, 0, 0.6);
    padding: 1px 4px;
    border-radius: 3px;
}

/* ═══ MODE INDICATOR ═══ */
#ModeIndicator {
    padding: 5px 12px;
    background-color: rgba(0, 0, 0, 0.4);
    border-radius: 8px;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.7);
    margin-left: auto;
    margin-right: 10px;
}

/* ═══ HINT TEXT ═══ */
#HintText {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.5);
    -unity-text-align: middle-center;
    margin-top: 10px;
}

/* ═══ 2x2 MODE HIDING ═══ */
.extra-slot {
    display: none;
}

.extra-row {
    display: none;
}

.mode-3x3 .extra-slot {
    display: flex;
}

.mode-3x3 .extra-row {
    display: flex;
}
